{
  "name": "telocc",
  "main": "src/entry.workers.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["17 2 * * *"]
  },
  "vars": {
    "APP_ENV": "production",
    "TELEPHONY_PROVIDER": "mock",
    "TWILIO_REGION": "ie1",
    "RETENTION_CALL_LOG_MONTHS": "13",
    "RETENTION_SECURITY_LOG_DAYS": "90",
    "COMPLIANCE_POSTURE": "app_layer"
  }
  // secrets via `wrangler secret put`: DATABASE_URL, BETTER_AUTH_SECRET, PIN_PEPPER,
  //   RESEND_API_KEY, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, MOCK_WEBHOOK_SECRET.
  // `nodejs_compat` (M11, docs/decisions.md #64): design.md §1 and the original M0
  //   comment here claimed no compatibility flag was needed, on the premise that only
  //   the per-entry DB driver split mattered. Since M0, `core/verification.ts`,
  //   `lib/auth.ts`, `routes/webhooks.ts` and `middleware/rate-limit.ts` all started
  //   importing `node:crypto` (HMAC/hash for PIN/webhook/rate-limit keys), and
  //   Better Auth's own dependency tree imports `node:async_hooks` — `wrangler deploy
  //   --dry-run` only ever *warned* about this (exit 0), it never failed the gate, so
  //   the drift went unnoticed. Without this flag those code paths — which is to say
  //   auth, webhooks, and rate limiting, i.e. most of the app — would throw at
  //   request time on real Workers. The flag is free at this compatibility_date (no
  //   behavioural opt-out needed elsewhere) and requires no code change.
}
