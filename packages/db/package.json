{
  "name": "@telocc/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./neon": "./src/neon.ts",
    "./node": "./src/node.ts",
    "./seed/*": "./src/seed/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "check": "drizzle-kit check",
    "seed": "tsx src/seed/run.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "@neondatabase/serverless": "1.1.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@better-auth/cli": "1.4.21",
    "drizzle-kit": "0.31.10",
    "better-auth": "1.6.23",
    "dotenv": "17.4.2",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
